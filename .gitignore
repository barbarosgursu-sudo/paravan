# build_html.js her derlemede bunları kaynak dosyalardan taze üretir
kaynak/_gomulu_motor.js
kaynak/_gomulu_veri.js
# test_sizinti.js her çalıştığında üretir (insan gözüyle okunmak için)
kaynak/_durum_matrisi.txt
# arac_ui_tur.js her çalıştığında ekran görüntüsü üretir (gözle bakmak için)
kaynak/UI_*.png
# arac_yeni_tur.js ekran görüntüleri
kaynak/YENI_UI/
referans/
# Bilgisayardaki tarayıcı aracı (Playwright + Chromium, ~200 MB) — yalnız yerelde
araclar/
# Resim üretiminde reddedilen resimler — yalnız yerelde
uretim/*/red/
# Yüz denetim aracının modelleri (arac_yuz.py ilk çalıştırmada indirir, ~39 MB)
uretim/referanslar/yuz_model/
__pycache__/
# Shorts hattı (arac_shorts.js): videolar, ara dosyalar, müzik, ses denemeleri yalnız yerelde.
# shorts/vN/denetim.json (spoiler damgası) depoya girer.
shorts/**/*.mp4
shorts/**/*.srt
shorts/**/*_yukleme.txt
shorts/*/_is/
shorts/muzik/
shorts/ses_deneme/
